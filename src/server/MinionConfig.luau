--!strict
-- ©Brusha and Claude^_^
-- MinionConfig (только сервер): все настройки приспешников в одном месте.
--
-- Почему отдельный файл: если захочется поменять размер кубика или лимит,
-- не придётся искать числа по всему коду. Почему на сервере: лимит и
-- перезарядку проверяет сервер, клиенту эти числа знать не нужно.

local MinionConfig = {
	-- Сколько приспешников один игрок может держать одновременно.
	MAX_MINIONS_PER_PLAYER = 3,

	-- Сколько секунд нужно подождать между двумя призывами.
	-- Защищает сервер от спама: без неё можно создать сотни кубиков в секунду.
	SUMMON_COOLDOWN_SECONDS = 1,

	-- Внешний вид кубика.
	MINION_SIZE = Vector3.new(1.5, 1.5, 1.5),
	MINION_COLOR = Color3.fromRGB(150, 150, 150),
	MINION_MATERIAL = Enum.Material.SmoothPlastic,

	-- Физика кубика: плотность, трение, упругость и «вес» трения и упругости.
	-- Высокое трение (1) нужно, чтобы кубик цеплялся за землю и перекатывался,
	-- а не скользил. Упругость 0 — чтобы не подпрыгивал после каждого переворота.
	MINION_PHYSICS = PhysicalProperties.new(0.7, 1, 0, 100, 100),

	-- Где кубики стоят относительно игрока (в стадах, studs — единица длины Roblox).
	DISTANCE_BEHIND_PLAYER = 5, -- насколько позади
	SPACING_BETWEEN_MINIONS = 3, -- расстояние между соседними кубиками в ряду

	-- Как кубик катится к своей точке.
	-- Скорость вращения считается в радианах в секунду: чем дальше кубик от
	-- своей точки, тем быстрее он крутится, но не быстрее MAX_ROLL_SPEED.
	ROLL_SPEED_PER_STUD = 2, -- прибавка скорости за каждый стад расстояния
	MAX_ROLL_SPEED = 20, -- ~20 рад/с хватает, чтобы догнать бегущего игрока
	MAX_ROLL_TORQUE = 5000, -- максимальная сила вращения, чтобы кубик мог перевернуться
	STOP_DISTANCE = 1.5, -- ближе этого кубик останавливается, чтобы не дёргаться на месте
	TELEPORT_DISTANCE = 50, -- дальше этого кубик отстал или застрял, переносим его к игроку

	-- Как часто сервер пересчитывает направление качения, в секундах.
	-- Каждый кадр (60 раз в секунду) не нужно: 10 раз в секунду на глаз
	-- выглядит так же, а серверу и сети проще.
	UPDATE_INTERVAL_SECONDS = 0.1,
}

-- table.freeze запрещает менять таблицу во время игры.
-- Если кто-то случайно напишет MinionConfig.MAX_MINIONS_PER_PLAYER = 100,
-- сразу будет ошибка, а не тихий баг.
return table.freeze(MinionConfig)
