--!strict
-- Morievskiy
-- Config: все константы тестового стенда (P0-стенд, работает на сервере и клиенте).
--
-- Задача файла — собрать все «магические числа» в одном месте, чтобы настраивать
-- нагрузку и баланс стенда правкой одного модуля. Часть чисел ниже — стартовые
-- значения, а не утверждённый баланс: PERF-001 открыт, пороги определяются
-- замерами (см. docs/TEST_STAND_PLAN.md).

local Config = {}

-- === Такт симуляции ==========================================================

-- Шаг симуляции, секунды (20 Гц). Фиксированный шаг нужен, чтобы объём работы
-- за секунду не зависел от частоты кадров конкретной машины и замеры были
-- сравнимы между прогонами.
Config.STEP_SECONDS = 0.05

-- === Арена ===================================================================

-- Бойцы ходят по плоскости XZ; Y — фиксированная высота пола стенда.
Config.ARENA_HALF_SIZE = 256 -- половина длины и ширины арены, studs
Config.GROUND_Y = 0 -- высота пола, studs

-- === Боец ====================================================================

Config.FIGHTER_RADIUS = 1 -- условный радиус бойца, studs (для сепарации и чек-суммы)
Config.FIGHTER_MAX_HEALTH = 100 -- HP каждого бойца
Config.FIGHTER_MOVE_SPEED = 8 -- скорость движения, studs/с
Config.FIGHTER_DAMAGE = 10 -- урон за удар
Config.ATTACK_RANGE = 2 -- дистанция удара, studs (от края до края)
-- Кулдаун больше шага в 2 раза, чтобы «удары через шаг» не совпадали по чек-сумме.
Config.ATTACK_COOLDOWN = 0.1 -- секунды между ударами

-- === Поиск цели ==============================================================

-- Клетка сетки. Меньше клетки — больше памяти, больше — больше пустых клеток
-- в запросе; 8 studs при поиске в радиусе 40 даёт 11×11 клеток на запрос.
Config.GRID_CELL_SIZE = 8
-- Радиус поиска цели, studs. Задаёт максимальную дистанцию, с которой боец
-- «видит» врага; 40 studs = 5 клеток вокруг текущей.
Config.TARGET_SEARCH_RADIUS = 40

-- === Сепарация ===============================================================

-- Радиус, в котором боец отталкивается от союзников, studs.
Config.SEPARATION_RADIUS = 2 * Config.FIGHTER_RADIUS

-- === Телеметрия ==============================================================

-- Ёмкость выборок времени шага. 3600 отсчётов = 3 минуты непрерывной работы
-- стенда на 20 Гц — больше любой длительности сценариев лестницы.
Config.METRICS_CAPACITY = 3600
-- Ёмкость кольцевого буфера строк STAND_METRIC до отправки/записи.
Config.METRICS_RING_CAPACITY = 128

-- Застрявший боец: за окно наблюдения сместился меньше порога.
Config.STUCK_WINDOW_SECONDS = 5
Config.STUCK_MIN_DISTANCE = 1

return Config
